# Copy to server/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=4000
# Local PostgreSQL (installed) or the embedded one started with `npm run db:local`
DATABASE_URL=postgres://betlink:CHANGE_ME@localhost:5432/betlink
SESSION_DAYS=14
# Set to the number of reverse proxies in front of the app (e.g. 1) ONLY when deployed behind one.
# Leave empty locally, otherwise clients could spoof X-Forwarded-For to dodge rate limits.
TRUST_PROXY=
# Optional: absolute path for uploaded images (defaults to server/uploads)
UPLOAD_DIR=
# Password the dev seed gives demo owner/agent/user accounts
SEED_PASSWORD=CHANGE_ME_demo_password
